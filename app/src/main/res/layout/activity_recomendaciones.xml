<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootRecomendaciones"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="18dp"
    android:paddingEnd="24dp"
    android:paddingBottom="18dp">

    <TextView
        android:id="@+id/txtTituloRecomendaciones"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="Recomendaciones"
        android:textColor="@color/text_dark"
        android:textSize="29sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/txtSubtituloRecomendaciones"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:lineSpacingExtra="3dp"
        android:text="Consejos personalizados según tus evaluaciones recientes."
        android:textColor="@color/text_soft"
        android:textSize="15sp" />

    <LinearLayout
        android:id="@+id/cardUsuarioRecomendaciones"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_notification_info_card"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="14dp">

        <FrameLayout
            android:layout_width="56dp"
            android:layout_height="56dp">

            <ImageView
                android:id="@+id/imgFotoUsuarioRecomendaciones"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:contentDescription="Foto de usuario"
                android:scaleType="centerCrop"
                android:visibility="gone" />

            <TextView
                android:id="@+id/txtInicialesUsuarioRecomendaciones"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/bg_success_chip"
                android:gravity="center"
                android:text="SX"
                android:textColor="@color/sentix_blue"
                android:textSize="19sp"
                android:textStyle="bold" />

        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtNombreUsuarioRecomendaciones"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Usuario Sentix"
                android:textColor="@color/text_dark"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtCorreoUsuarioRecomendaciones"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Cuenta activa"
                android:textColor="@color/text_soft"
                android:textSize="13sp" />

        </LinearLayout>

    </LinearLayout>

    <TextView
        android:id="@+id/txtResumenBase"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_success_notice"
        android:lineSpacingExtra="4dp"
        android:padding="13dp"
        android:text="Basado en tus últimas evaluaciones guardadas."
        android:textColor="@color/text_dark"
        android:textSize="14sp" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollContenidoRecomendaciones"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="14dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/contenedorContenidoRecomendaciones"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/cardRecomendacionPrincipal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_notification_info_card"
                android:elevation="2dp"
                android:orientation="vertical"
                android:padding="18dp">

                <ImageView
                    android:id="@+id/imgRecomendacionPrincipal"
                    android:layout_width="match_parent"
                    android:layout_height="175dp"
                    android:adjustViewBounds="true"
                    android:contentDescription="Ilustración de recomendación"
                    android:scaleType="fitCenter"
                    android:src="@drawable/img_reco_bienestar" />

                <TextView
                    android:id="@+id/txtEtiquetaContexto"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Orientación personalizada"
                    android:textColor="@color/text_soft"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/txtTituloRecomendacionPrincipal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Recomendación principal"
                    android:textColor="@color/sentix_blue"
                    android:textSize="23sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtMensajeRecomendacionPrincipal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:justificationMode="inter_word"
                    android:lineSpacingExtra="4dp"
                    android:text="Aquí aparecerá una recomendación personalizada según tu historial emocional."
                    android:textAlignment="viewStart"
                    android:textColor="@color/text_dark"
                    android:textSize="15sp" />

            </LinearLayout>

            <TextView
                android:id="@+id/txtTituloAccionesRapidas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Acciones sugeridas"
                android:textColor="@color/text_dark"
                android:textSize="19sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/contenedorAccionesRapidas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical" />

            <LinearLayout
                android:id="@+id/cardPlanApoyo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_success_feature_card"
                android:elevation="2dp"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:id="@+id/txtTituloPlanApoyo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Plan sugerido"
                    android:textColor="@color/sentix_purple"
                    android:textSize="19sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtPlanHoy"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:lineSpacingExtra="4dp"
                    android:text="Hoy: realiza una pausa breve."
                    android:textColor="@color/text_dark"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/txtPlanSemana"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:lineSpacingExtra="4dp"
                    android:text="Esta semana: registra cómo te sientes."
                    android:textColor="@color/text_dark"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/txtPlanContinua"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:lineSpacingExtra="4dp"
                    android:text="Si continúa: conversa con alguien de confianza."
                    android:textColor="@color/text_dark"
                    android:textSize="14sp" />

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnVerHistorial"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_button_outline_sentix"
            android:backgroundTint="@null"
            app:backgroundTint="@null"
            android:text="Ver historial"
            android:textAllCaps="false"
            android:textColor="@color/sentix_blue"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnNuevaEvaluacion"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_button"
            android:backgroundTint="@null"
            app:backgroundTint="@null"
            android:text="Evaluarme"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:textStyle="bold" />

    </LinearLayout>

</LinearLayout>