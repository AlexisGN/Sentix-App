<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_sentix"
    android:orientation="vertical"
    android:padding="22dp">

    <FrameLayout
        android:layout_width="68dp"
        android:layout_height="68dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_notification_icon_circle">

        <ImageView
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_gravity="center"
            android:contentDescription="Icono de notificaciones"
            android:src="@drawable/ic_notifications_sentix"
            app:tint="@color/white" />

    </FrameLayout>

    <TextView
        android:id="@+id/txtTituloNotificaciones"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:text="Notificaciones Sentix"
        android:textColor="@color/text_dark"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/txtEstadoNotificaciones"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_notification_chip_off"
        android:gravity="center"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:text="Desactivadas"
        android:textColor="@color/text_soft"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/txtDescripcionNotificaciones"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:lineSpacingExtra="4dp"
        android:text="Activa notificaciones para recibir recordatorios y avisos preventivos de Sentix."
        android:textColor="@color/text_soft"
        android:textSize="15sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:background="@drawable/bg_notification_info_card"
        android:orientation="vertical"
        android:padding="15dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="¿Qué recibirás?"
            android:textColor="@color/text_dark"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:lineSpacingExtra="4dp"
            android:text="• Recordatorios para evaluarte&#10;• Avisos de recomendaciones&#10;• Alertas preventivas suaves"
            android:textColor="@color/text_soft"
            android:textSize="13sp" />

    </LinearLayout>

    <Button
        android:id="@+id/btnAccionNotificaciones"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="22dp"
        android:background="@drawable/bg_button"
        android:backgroundTint="@null"
        android:text="Activar notificaciones"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="15sp"
        android:textStyle="bold"
        app:backgroundTint="@null" />

    <Button
        android:id="@+id/btnPruebaNotificaciones"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_button_outline_sentix"
        android:backgroundTint="@null"
        android:text="Enviar prueba"
        android:textAllCaps="false"
        android:textColor="@color/sentix_blue"
        android:textSize="15sp"
        android:textStyle="bold"
        app:backgroundTint="@null" />

    <TextView
        android:id="@+id/btnCancelarNotificaciones"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:padding="8dp"
        android:text="Cerrar"
        android:textColor="@color/text_soft"
        android:textSize="14sp"
        android:textStyle="bold" />

</LinearLayout>