<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootEditarPerfil"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="18dp"
        android:paddingEnd="24dp"
        android:paddingBottom="18dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="54dp">

            <ImageButton
                android:id="@+id/btnVolverEditarPerfil"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="start|center_vertical"
                android:background="@drawable/bg_menu_item_sidebar"
                android:padding="11dp"
                android:src="@android:drawable/ic_media_previous"
                app:tint="@color/white" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="Editar perfil"
                android:textColor="@color/text_dark"
                android:textSize="24sp"
                android:textStyle="bold" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:background="@drawable/bg_tutorial_card"
            android:elevation="2dp"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:text="Usuario"
                android:textColor="@color/sentix_purple"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <EditText
                android:id="@+id/edtUsuarioEditar"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_profile_input"
                android:hint="Nombre de usuario"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:singleLine="true"
                android:textColor="@color/text_dark"
                android:textColorHint="@color/text_soft" />

            <TextView
                android:text="Nombre"
                android:textColor="@color/sentix_purple"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginTop="14dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <EditText
                android:id="@+id/edtNombreEditar"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_profile_input"
                android:hint="Nombres"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:singleLine="true"
                android:textColor="@color/text_dark"
                android:textColorHint="@color/text_soft" />

            <TextView
                android:text="Apellido paterno"
                android:textColor="@color/sentix_purple"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginTop="14dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <EditText
                android:id="@+id/edtApellidoPaternoEditar"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_profile_input"
                android:hint="Apellido paterno"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:singleLine="true"
                android:textColor="@color/text_dark"
                android:textColorHint="@color/text_soft" />

            <TextView
                android:text="Apellido materno"
                android:textColor="@color/sentix_purple"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginTop="14dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <EditText
                android:id="@+id/edtApellidoMaternoEditar"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_profile_input"
                android:hint="Apellido materno"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:singleLine="true"
                android:textColor="@color/text_dark"
                android:textColorHint="@color/text_soft" />

            <TextView
                android:text="Fecha de nacimiento"
                android:textColor="@color/sentix_purple"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginTop="14dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <EditText
                android:id="@+id/edtFechaNacimientoEditar"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_profile_input"
                android:focusable="false"
                android:hint="DD/MM/AAAA"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:singleLine="true"
                android:textColor="@color/text_dark"
                android:textColorHint="@color/text_soft" />

            <TextView
                android:text="Correo electrónico"
                android:textColor="@color/sentix_purple"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginTop="14dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <EditText
                android:id="@+id/edtCorreoEditar"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_profile_input"
                android:enabled="false"
                android:hint="Correo"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:singleLine="true"
                android:textColor="@color/text_soft"
                android:textColorHint="@color/text_soft" />

            <Button
                android:id="@+id/btnGuardarEditarPerfil"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_button"
                android:backgroundTint="@null"
                app:backgroundTint="@null"
                android:text="Guardar cambios"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>