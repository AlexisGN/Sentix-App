<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootResultadoEvaluacion"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:overScrollMode="never"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="52dp"
        android:paddingTop="20dp"
        android:paddingEnd="22dp"
        android:paddingBottom="24dp">

        <ImageView
            android:id="@+id/imgLogoSentixResultado"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:adjustViewBounds="true"
            android:contentDescription="Logo Sentix"
            android:scaleType="fitCenter"
            android:src="@drawable/sentix_logo" />

        <TextView
            android:id="@+id/txtTituloResultado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:text="Resultado de tu evaluación"
            android:textColor="@color/text_dark"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtSubtituloResultado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:gravity="center"
            android:lineSpacingExtra="3dp"
            android:text="Este resultado es una orientación preventiva."
            android:textColor="@color/text_soft"
            android:textSize="14sp" />

        <ImageView
            android:id="@+id/imgResultadoIlustracion"
            android:layout_width="match_parent"
            android:layout_height="215dp"
            android:layout_marginTop="14dp"
            android:adjustViewBounds="true"
            android:contentDescription="Ilustración del resultado"
            android:scaleType="fitCenter"
            android:src="@drawable/img_resultado_favorable" />

        <TextView
            android:id="@+id/txtIconoResultado"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/txtNivelFinal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center"
            android:text="Estado favorable"
            android:textColor="@color/sentix_blue"
            android:textSize="25sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtMensajeResultado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="9dp"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:text="Tu evaluación muestra señales favorables en este momento."
            android:textColor="@color/text_dark"
            android:textSize="14sp" />

        <LinearLayout
            android:id="@+id/contenedorEscalaResultado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:orientation="vertical">
            <Space
                android:layout_width="match_parent"
                android:layout_height="20dp" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="34dp"
                android:gravity="center"
                android:orientation="horizontal">

                <View
                    android:id="@+id/indicadorFavorable"
                    android:layout_width="22dp"
                    android:layout_height="22dp" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="3dp"
                    android:layout_weight="1"
                    android:background="#D1D5DB" />

                <View
                    android:id="@+id/indicadorLeve"
                    android:layout_width="22dp"
                    android:layout_height="22dp" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="3dp"
                    android:layout_weight="1"
                    android:background="#D1D5DB" />

                <View
                    android:id="@+id/indicadorSeguimiento"
                    android:layout_width="22dp"
                    android:layout_height="22dp" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="3dp"
                    android:layout_weight="1"
                    android:background="#D1D5DB" />

                <View
                    android:id="@+id/indicadorAtencion"
                    android:layout_width="22dp"
                    android:layout_height="22dp" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/txtLabelFavorable"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="Favorable"
                    android:textColor="@color/text_soft"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/txtLabelLeve"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="Leve"
                    android:textColor="@color/text_soft"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/txtLabelSeguimiento"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="Seguimiento"
                    android:textColor="@color/text_soft"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/txtLabelAtencion"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="Atención"
                    android:textColor="@color/text_soft"
                    android:textSize="10sp" />

            </LinearLayout>

        </LinearLayout>
        <Space
            android:layout_width="match_parent"
            android:layout_height="20dp" />
        <LinearLayout
            android:id="@+id/cardRecomendacion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:elevation="1dp"
            android:orientation="horizontal"
            android:padding="16dp">

            <ImageView
                android:id="@+id/imgIconoRecomendacion"
                android:layout_width="58dp"
                android:layout_height="58dp"
                android:layout_gravity="top"
                android:adjustViewBounds="true"
                android:contentDescription="Icono de recomendación"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_recomendacion_default" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtTituloRecomendacion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Recomendación"
                    android:textColor="@color/sentix_blue"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtMensajeRecomendacion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:justificationMode="inter_word"
                    android:lineSpacingExtra="4dp"
                    android:text="Mantén tus hábitos de autocuidado y equilibra estudio, descanso y actividades que te hagan bien."
                    android:textAlignment="viewStart"
                    android:textColor="@color/text_dark"
                    android:textSize="14sp" />

            </LinearLayout>

        </LinearLayout>

        <TextView
            android:id="@+id/txtAvisoProfesional"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone" />
        <Space
            android:layout_width="match_parent"
            android:layout_height="20dp" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnVerHistorial"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_button_outline_sentix"
                android:backgroundTint="@null"
                app:backgroundTint="@null"
                android:text="Ver historial"
                android:textAllCaps="false"
                android:textColor="@color/sentix_blue"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnVolverInicio"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_button"
                android:backgroundTint="@null"
                app:backgroundTint="@null"
                android:text="Volver al inicio"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:textStyle="bold" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/cardResultadoPrincipal"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:orientation="vertical"
            android:visibility="gone" />

    </LinearLayout>

</ScrollView>