<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootHistorialEmocional"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="52dp"
    android:paddingTop="14dp"
    android:paddingEnd="22dp"
    android:paddingBottom="18dp">

    <TextView
        android:id="@+id/txtTituloHistorial"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Historial emocional"
        android:textColor="@color/text_dark"
        android:textSize="28sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/txtSubtituloHistorial"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:lineSpacingExtra="2dp"
        android:text="Consulta tus evaluaciones guardadas por fecha."
        android:textColor="@color/text_soft"
        android:textSize="14sp" />

    <LinearLayout
        android:id="@+id/cardUsuarioHistorial"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_notification_info_card"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <FrameLayout
            android:layout_width="52dp"
            android:layout_height="52dp">

            <ImageView
                android:id="@+id/imgFotoUsuarioHistorial"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:contentDescription="Foto de usuario"
                android:scaleType="centerCrop"
                android:visibility="gone" />

            <TextView
                android:id="@+id/txtInicialesUsuarioHistorial"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/bg_success_chip"
                android:gravity="center"
                android:text="SX"
                android:textColor="@color/sentix_blue"
                android:textSize="18sp"
                android:textStyle="bold" />

        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtNombreUsuarioHistorial"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Usuario Sentix"
                android:textColor="@color/text_dark"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtCorreoUsuarioHistorial"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Cuenta activa"
                android:textColor="@color/text_soft"
                android:textSize="12sp" />

        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/cardGraficoHistorial"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_notification_info_card"
        android:elevation="2dp"
        android:orientation="vertical"
        android:padding="14dp">

        <TextView
            android:id="@+id/txtTituloGrafico"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Gráfico semanal"
            android:textColor="@color/text_dark"
            android:textSize="17sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/contenedorGrafico"
            android:layout_width="match_parent"
            android:layout_height="176dp"
            android:layout_marginTop="12dp"
            android:gravity="bottom"
            android:orientation="horizontal" />

        <LinearLayout
            android:id="@+id/contenedorSelectorSemana"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnSemanaAnterior"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/bg_button"
                android:gravity="center"
                android:text="‹"
                android:textColor="@color/white"
                android:textSize="30sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtMesSemana"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:layout_weight="1"
                android:background="@drawable/bg_success_chip"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center"
                android:text="Junio 2026"
                android:textColor="@color/text_dark"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnSemanaSiguiente"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/bg_button"
                android:gravity="center"
                android:text="›"
                android:textColor="@color/white"
                android:textSize="30sp"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>

    <FrameLayout
        android:id="@+id/contenedorZonaHistorial"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/panelListaDia"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_success_feature_card"
            android:elevation="2dp"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:id="@+id/txtTituloDiaSeleccionado"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Evaluaciones del día"
                android:textColor="@color/sentix_purple"
                android:textSize="16sp"
                android:textStyle="bold" />

            <androidx.core.widget.NestedScrollView
                android:id="@+id/scrollEvaluacionesDia"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="10dp"
                android:layout_weight="1"
                android:fillViewport="true"
                android:overScrollMode="never"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/contenedorEvaluacionesDia"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

            </androidx.core.widget.NestedScrollView>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/panelDetalleEvaluacion"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_notification_info_card"
            android:elevation="2dp"
            android:orientation="vertical"
            android:padding="14dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/btnVolverLista"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="← Volver a las evaluaciones"
                android:textColor="@color/sentix_blue"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtFechaDetalle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Fecha y hora"
                android:textColor="@color/text_soft"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/txtNivelDetalle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Resultado"
                android:textColor="@color/sentix_blue"
                android:textSize="22sp"
                android:textStyle="bold" />

            <androidx.core.widget.NestedScrollView
                android:id="@+id/scrollDetalleEvaluacion"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="10dp"
                android:layout_weight="1"
                android:fillViewport="true"
                android:overScrollMode="never"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/txtTextoUsuarioDetalle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:lineSpacingExtra="4dp"
                        android:text="Texto registrado"
                        android:textColor="@color/text_dark"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/txtTestDetalle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Test emocional"
                        android:textColor="@color/text_dark"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/txtTextoDetalle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Análisis de texto"
                        android:textColor="@color/text_dark"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/txtImagenDetalle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Imagen facial"
                        android:textColor="@color/text_dark"
                        android:textSize="14sp" />

                </LinearLayout>

            </androidx.core.widget.NestedScrollView>

        </LinearLayout>

    </FrameLayout>

    <Button
        android:id="@+id/btnNuevaEvaluacion"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_button"
        android:backgroundTint="@null"
        app:backgroundTint="@null"
        android:text="Realizar nueva evaluación"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="15sp"
        android:textStyle="bold" />

</LinearLayout>