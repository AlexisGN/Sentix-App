<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootEvaluacionCamara"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:overScrollMode="never"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="52dp"
        android:paddingTop="12dp"
        android:paddingEnd="22dp"
        android:paddingBottom="30dp">

        <TextView
            android:id="@+id/txtTituloEvaluacionCamara"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Captura facial"
            android:textColor="@color/text_dark"
            android:textSize="32sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtSubtituloEvaluacionCamara"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:lineSpacingExtra="2dp"
            android:text="Ubica tu rostro dentro del marco para iniciar la evaluación."
            android:textColor="@color/text_soft"
            android:textSize="16sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_success_notice"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingTop="12dp"
            android:paddingEnd="14dp"
            android:paddingBottom="12dp">

            <ImageView
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_gravity="center_vertical"
                android:src="@drawable/proteger"
                app:tint="@color/sentix_blue" />

            <TextView
                android:id="@+id/txtIndicacionCamara"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:lineSpacingExtra="2dp"
                android:text="Mira de frente y procura buena iluminación."
                android:textColor="@color/text_dark"
                android:textSize="14sp" />

        </LinearLayout>

        <FrameLayout
            android:id="@+id/cardPreviewCamara"
            android:layout_width="match_parent"
            android:layout_height="430dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_camera_preview_card"
            android:clipToOutline="true"
            android:padding="0dp">

            <androidx.camera.view.PreviewView
                android:id="@+id/previewCamara"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/black"
                app:scaleType="fillCenter" />

            <View
                android:id="@+id/viewMarcoRostro"
                android:layout_width="285dp"
                android:layout_height="340dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_face_frame" />

            <TextView
                android:id="@+id/txtEstadoCamara"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="18dp"
                android:background="@drawable/bg_success_chip"
                android:gravity="center"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:text="Cámara lista"
                android:textColor="@color/sentix_purple"
                android:textSize="14sp"
                android:textStyle="bold" />

        </FrameLayout>

        <Button
            android:id="@+id/btnCapturarImagen"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_button"
            android:backgroundTint="@null"
            app:backgroundTint="@null"
            android:text="Capturar imagen"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- Se mantiene oculto para no romper referencias del Activity -->
        <Button
            android:id="@+id/btnContinuarTest"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_button_outline_sentix"
            android:backgroundTint="@null"
            app:backgroundTint="@null"
            android:enabled="false"
            android:text="Continuar con el test"
            android:textAllCaps="false"
            android:textColor="@color/sentix_blue"
            android:textSize="15sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <!-- Se mantiene oculto para conservar la lógica interna sin mostrar DEV -->
        <TextView
            android:id="@+id/txtResultadoDev"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:background="@drawable/bg_notification_info_card"
            android:lineSpacingExtra="3dp"
            android:padding="14dp"
            android:text=""
            android:textColor="@color/text_soft"
            android:textSize="13sp"
            android:visibility="gone" />

    </LinearLayout>

</ScrollView>