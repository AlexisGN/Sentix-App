<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootAlertasPreventivas"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="52dp"
    android:paddingTop="18dp"
    android:paddingEnd="22dp"
    android:paddingBottom="18dp">

    <!-- TÍTULO PRINCIPAL -->
    <TextView
        android:id="@+id/txtTituloAlertas"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Alertas preventivas"
        android:textColor="@color/text_dark"
        android:textSize="29sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/txtSubtituloAlertas"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:lineSpacingExtra="3dp"
        android:text="Señales de cuidado basadas en tus evaluaciones recientes."
        android:textColor="@color/text_soft"
        android:textSize="15sp" />

    <LinearLayout
        android:id="@+id/cardUsuarioAlertas"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_notification_info_card"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="14dp">

        <FrameLayout
            android:layout_width="56dp"
            android:layout_height="56dp">

            <ImageView
                android:id="@+id/imgFotoUsuarioAlertas"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:contentDescription="Foto de usuario"
                android:scaleType="centerCrop"
                android:visibility="gone" />

            <TextView
                android:id="@+id/txtInicialesUsuarioAlertas"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/bg_success_chip"
                android:gravity="center"
                android:text="SX"
                android:textColor="@color/sentix_blue"
                android:textSize="19sp"
                android:textStyle="bold" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtNombreUsuarioAlertas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Usuario Sentix"
                android:textColor="@color/text_dark"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtCorreoUsuarioAlertas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Cuenta activa"
                android:textColor="@color/text_soft"
                android:textSize="13sp" />
        </LinearLayout>

    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollContenidoAlertas"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="14dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/contenedorContenidoAlertas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/cardAlertaPrincipal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_notification_info_card"
                android:elevation="2dp"
                android:orientation="vertical"
                android:padding="18dp">

                <ImageView
                    android:id="@+id/imgIconoAlertaPrincipal"
                    android:layout_width="88dp"
                    android:layout_height="88dp"
                    android:layout_gravity="center_horizontal"
                    android:contentDescription="Icono de alerta preventiva"
                    android:padding="16dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_alerta_estable" />

                <TextView
                    android:id="@+id/txtEtiquetaAlerta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center"
                    android:text="Estado preventivo"
                    android:textColor="@color/text_soft"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/txtTituloAlertaPrincipal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:text="Sin alertas activas"
                    android:textColor="@color/sentix_green"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtMensajeAlertaPrincipal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center"
                    android:lineSpacingExtra="4dp"
                    android:text="No se detectan señales repetidas que requieran una alerta preventiva."
                    android:textColor="@color/text_dark"
                    android:textSize="15sp" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/cardBaseAlerta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_success_notice"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/txtTituloBaseAlerta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Base de la alerta"
                    android:textColor="@color/sentix_blue"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtBaseAlerta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:lineSpacingExtra="4dp"
                    android:text="Se revisan tus evaluaciones recientes para identificar señales repetidas."
                    android:textAlignment="viewStart"
                    android:textColor="@color/text_dark"
                    android:textSize="14sp" />

            </LinearLayout>

            <TextView
                android:id="@+id/txtTituloSenales"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Señales revisadas"
                android:textColor="@color/text_dark"
                android:textSize="19sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/contenedorSenales"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical" />

            <LinearLayout
                android:id="@+id/cardAccionSugerida"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_success_feature_card"
                android:elevation="2dp"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:id="@+id/txtTituloAccionSugerida"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Acción sugerida"
                    android:textColor="@color/sentix_purple"
                    android:textSize="19sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtAccionSugerida"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:justificationMode="inter_word"
                    android:lineSpacingExtra="4dp"
                    android:text="Continúa observando tu bienestar y realiza nuevas evaluaciones si notas cambios."
                    android:textAlignment="viewStart"
                    android:textColor="@color/text_dark"
                    android:textSize="14sp" />

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnVerRecomendaciones"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_button_outline_sentix"
            android:backgroundTint="@null"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="Recomendaciones"
            android:textAllCaps="false"
            android:textColor="@color/sentix_blue"
            android:textSize="13sp"
            android:textStyle="bold"
            app:backgroundTint="@null" />

        <Button
            android:id="@+id/btnNuevaEvaluacion"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_button"
            android:backgroundTint="@null"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="Evaluarme"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold"
            app:backgroundTint="@null" />

    </LinearLayout>

</LinearLayout>