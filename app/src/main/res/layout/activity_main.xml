<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen">

    <ImageView
        android:layout_width="220dp"
        android:layout_height="255dp"
        android:layout_gravity="top|start"
        android:layout_marginStart="-5dp"
        android:layout_marginTop="0dp"
        android:src="@drawable/bg_top_curve" />

    <ImageView
        android:id="@+id/imageView"
        android:layout_width="130dp"
        android:layout_height="85dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="45dp"
        android:layout_marginEnd="16dp"
        app:srcCompat="@drawable/logo_upn" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="28dp"
            android:paddingEnd="28dp"
            android:paddingTop="120dp"
            android:paddingBottom="30dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:text="Login"
                android:textColor="@color/text_dark"
                android:textSize="34sp"
                android:textStyle="bold" />

            <ImageView
                android:layout_width="120dp"
                android:layout_height="100dp"
                android:layout_marginTop="10dp"
                android:src="@drawable/icono" />

            <EditText
                android:id="@+id/edtEmail"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginTop="35dp"
                android:backgroundTint="@color/input_border"
                android:drawableStart="@drawable/ic_email"
                android:drawablePadding="14dp"
                android:hint="Correo o Usuario"
                android:inputType="textEmailAddress"
                android:textColor="@color/text_dark"
                android:textColorHint="@color/text_soft"
                android:textSize="18sp"
                app:drawableTint="@color/sentix_blue" />

            <EditText
                android:id="@+id/edtPassword"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginTop="12dp"
                android:backgroundTint="@color/input_border"
                android:drawableStart="@drawable/ic_lock"
                android:drawablePadding="14dp"
                android:hint="Contraseña"
                android:inputType="textPassword"
                android:textColor="@color/text_dark"
                android:textColorHint="@color/text_soft"
                android:textSize="18sp"
                app:drawableTint="@color/sentix_purple" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:orientation="horizontal">

                <CheckBox
                    android:id="@+id/chkMostrarPassword"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:buttonTint="@color/sentix_blue"
                    android:text="Ver contraseña"
                    android:textColor="@color/text_dark"
                    android:textSize="13sp" />

                <CheckBox
                    android:id="@+id/chkRecordar"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:buttonTint="@color/sentix_purple"
                    android:text="Recordar cuenta"
                    android:textColor="@color/text_dark"
                    android:textSize="13sp" />
            </LinearLayout>

            <Button
                android:id="@+id/btnLogin"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginTop="22dp"
                android:background="@drawable/bg_button"
                android:backgroundTint="@null"
                app:backgroundTint="@null"
                android:text="INGRESAR"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btnBiometrico"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_marginTop="16dp"
                android:background="@android:color/transparent"
                android:contentDescription="Ingresar con biometría"
                android:padding="8dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_fingerprint"
                app:tint="@color/sentix_blue"
                android:visibility="gone" />

            <TextView
                android:id="@+id/txtRegistro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="center"
                android:text="¿No tienes cuenta? Regístrate"
                android:textColor="@color/sentix_purple"
                android:textSize="16sp" />

        </LinearLayout>
    </ScrollView>
</FrameLayout>