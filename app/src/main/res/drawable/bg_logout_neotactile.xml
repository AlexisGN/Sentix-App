<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_pressed="true">
        <shape>
            <solid android:color="#804A6990" />
            <corners android:radius="20dp" />
            <stroke
                android:width="1dp"
                android:color="#CCDBE4ED" />
        </shape>
    </item>

    <item>
        <shape>
            <solid android:color="#55161F29" />
            <corners android:radius="20dp" />
            <stroke
                android:width="1dp"
                android:color="#70465768" />
        </shape>
    </item>

</selector>