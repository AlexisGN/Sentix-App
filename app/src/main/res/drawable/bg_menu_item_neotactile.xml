<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_pressed="true">
        <shape>
            <gradient
                android:angle="0"
                android:startColor="#804A6990"
                android:endColor="#80606F81" />

            <corners android:radius="18dp" />

            <stroke
                android:width="1dp"
                android:color="#CCDBE4ED" />
        </shape>
    </item>

    <item>
        <shape>
            <solid android:color="#38DBE4ED" />

            <corners android:radius="18dp" />

            <stroke
                android:width="1dp"
                android:color="#80CDD4DF" />
        </shape>
    </item>

</selector>