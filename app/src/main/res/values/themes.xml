<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Tema base Sentix -->
    <style name="Base.Theme.Login_Guevara" parent="Theme.Material3.Light.NoActionBar">

        <!-- Tipografía -->
        <item name="android:fontFamily">sans-serif</item>

        <!-- Colores principales Sentix -->
        <item name="colorPrimary">@color/sentix_blue</item>
        <item name="colorPrimaryVariant">@color/sentix_blue</item>
        <item name="colorSecondary">@color/sentix_purple</item>
        <item name="android:colorAccent">@color/sentix_blue</item>

        <!-- Barra superior e inferior del sistema -->
        <item name="android:statusBarColor">@color/bg_light</item>
        <item name="android:navigationBarColor">@color/white</item>

        <!-- Iconos oscuros en barra superior e inferior -->
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>

        <!-- Sin ActionBar -->
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>

        <!-- Quitar transición entre Activities -->
        <item name="android:windowAnimationStyle">@style/NoActivityAnimation</item>

    </style>

    <!-- Sin animación entre pantallas -->
    <style name="NoActivityAnimation">
        <item name="android:activityOpenEnterAnimation">@null</item>
        <item name="android:activityOpenExitAnimation">@null</item>
        <item name="android:activityCloseEnterAnimation">@null</item>
        <item name="android:activityCloseExitAnimation">@null</item>
        <item name="android:taskOpenEnterAnimation">@null</item>
        <item name="android:taskOpenExitAnimation">@null</item>
        <item name="android:taskCloseEnterAnimation">@null</item>
        <item name="android:taskCloseExitAnimation">@null</item>
    </style>

    <!-- DatePicker adaptado a Sentix -->
    <style name="DatePickerStyle" parent="Theme.Material3.Light.Dialog.Alert">

        <item name="colorPrimary">@color/sentix_blue</item>
        <item name="colorSecondary">@color/sentix_purple</item>
        <item name="android:colorAccent">@color/sentix_purple</item>

        <item name="android:textColorPrimary">#1F2937</item>
        <item name="android:textColorSecondary">#6B7280</item>
        <item name="colorOnSurface">#1F2937</item>
        <item name="colorOnPrimary">@color/white</item>

        <item name="android:buttonBarButtonStyle">@style/DatePickerButtonStyle</item>
        <item name="buttonBarButtonStyle">@style/DatePickerButtonStyle</item>
    </style>

    <style name="DatePickerButtonStyle" parent="@android:style/Widget.Material.Button.Borderless">
        <item name="android:textColor">@color/sentix_blue</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- Tema final -->
    <style name="Theme.Login_Guevara" parent="Base.Theme.Login_Guevara" />

    <style name="Theme.Login_Guevara.AppWidgetContainerParent" parent="@android:style/Theme.DeviceDefault">
        <!-- Radius of the outer bound of widgets to make the rounded corners -->
        <item name="appWidgetRadius">16dp</item>
        <!--
        Radius of the inner view's bound of widgets to make the rounded corners.
        It needs to be 8dp or less than the value of appWidgetRadius
        -->
        <item name="appWidgetInnerRadius">8dp</item>
    </style>

    <style name="Theme.Login_Guevara.AppWidgetContainer" parent="Theme.Login_Guevara.AppWidgetContainerParent">
        <!-- Apply padding to avoid the content of the widget colliding with the rounded corners -->
        <item name="appWidgetPadding">16dp</item>
    </style>

</resources>