<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Base.Theme.Login_Guevara" parent="Theme.Material3.Light.NoActionBar">

        <!-- Tipografía -->
        <item name="android:fontFamily">sans-serif</item>

        <!-- Colores principales Sentix -->
        <item name="colorPrimary">@color/sentix_blue</item>
        <item name="colorPrimaryVariant">@color/sentix_blue</item>
        <item name="colorSecondary">@color/sentix_purple</item>
        <item name="android:colorAccent">@color/sentix_blue</item>

        <!-- Barra superior e inferior del sistema -->
        <item name="android:statusBarColor">@color/bg_light</item>
        <item name="android:navigationBarColor">@color/white</item>

        <!-- Iconos oscuros -->
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>

        <!-- Sin ActionBar -->
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>

        <!-- Quitar transición entre Activities -->
        <item name="android:windowAnimationStyle">@style/NoActivityAnimation</item>

    </style>

    <!-- Sin animación entre pantallas -->
    <style name="NoActivityAnimation">
        <item name="android:activityOpenEnterAnimation">@null</item>
        <item name="android:activityOpenExitAnimation">@null</item>
        <item name="android:activityCloseEnterAnimation">@null</item>
        <item name="android:activityCloseExitAnimation">@null</item>
        <item name="android:taskOpenEnterAnimation">@null</item>
        <item name="android:taskOpenExitAnimation">@null</item>
        <item name="android:taskCloseEnterAnimation">@null</item>
        <item name="android:taskCloseExitAnimation">@null</item>
    </style>

    <style name="Theme.Login_Guevara" parent="Base.Theme.Login_Guevara" />

</resources>